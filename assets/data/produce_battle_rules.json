        "exam"
      ],
      "drink_effects": {
        "score+=10": "fixed_score",
        "genki+=7": "shield_drink",
        "goodImpressionTurns+=3": "impression",
        "motivation+=3": "motivation_drink",
        "exchangeHand; fixedStamina+=2": "exchange",
        "fixedStamina+=6": "heal_drink",
        "upgradeHand; fixedStamina+=3": "upgrade",
        "setScoreBuff(0.3,3); halfCostTurns+=3; fixedStamina-=2": "boost",
        "moveRandomToHand[pIdol & (deck | discarded)]; halfCostTurns+=3": "intrinsic_draw",
        "setScoreBuff(0.1,5); drawCard(2); fixedStamina-=2; at:afterStartOfTurn { drawCard; limit:5 }": "soda_draw",
        "score+=goodImpressionTurns; genki+=3": "impression_score",
        "cardUsesRemaining+=1": "extra",
        "addRandomUpgradedSSRCardToHand": "random_draw",
        "at:endOfTurn { goodImpressionTurns+=1 }": "persistent",
        "at:endOfTurn { motivation+=1 }": "persistent_drive",
        "at:cardUsed[active] { if:cardRarity!=L { doubleCardEffectCards+=1 }; limit:1; ttl:1 }; fixedStamina-=2; doubleCostTurns+=1": "double_active"
      },
      "rules": [
        {
